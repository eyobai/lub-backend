# ── Runtime ──
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
LOG_LEVEL=debug
TRUST_PROXY=false
SWAGGER_ENABLED=true

# ── Data stores ──
POSTGRES_USER=lub
POSTGRES_PASSWORD=lub_dev_password
POSTGRES_DB=lub
DATABASE_URL=postgresql://lub:lub_dev_password@localhost:5432/lub?schema=public
REDIS_URL=redis://localhost:6379

# ── Auth ── (generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=lub-auction

# Login brute-force protection
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
LOGIN_FAILURE_WINDOW_SECONDS=900

# ── Money ──
# Currency used when a request does not name one (must exist in the currencies table).
DEFAULT_CURRENCY=ETB

# ── Phone verification / OTP ──
# false = register with phone number + password only: no SMS is sent, the account works immediately,
#         and SMS-based password reset is unavailable (resets go through an admin).
# true  = registration and password reset require an SMS code; needs a real OTP_PROVIDER.
PHONE_VERIFICATION_REQUIRED=false
# none    = no SMS delivery (only valid with PHONE_VERIFICATION_REQUIRED=false)
# console = development only (logs the code). The app refuses to start with it when NODE_ENV=production.
OTP_PROVIDER=none
OTP_HMAC_SECRET=change-me-otp-hmac-secret-at-least-32-chars
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5

# ── Phone numbers ──
# ISO-3166 alpha-2 list of countries whose mobile numbers may register
PHONE_ALLOWED_COUNTRIES=ET
PHONE_DEFAULT_COUNTRY=ET

# ── Rate limiting (requests per window) ──
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10

# ── Bootstrap super admin (used by `npm run seed`) ──
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=

# ── Auctions ──
# How often (seconds) scheduled auctions are opened and finished ones closed. 0 disables the background job.
AUCTION_SWEEP_INTERVAL_SECONDS=5
# How long (minutes) before an auction closes its bidders are reminded. 0 disables reminders.
AUCTION_CLOSING_REMINDER_MINUTES=60

# ── Notifications ──
# In-app notifications are always stored. SMS, email and push are sent only if a provider is registered in
# NotificationsModule; this is how often (seconds) pending ones are sent. 0 disables the background job.
NOTIFICATION_DISPATCH_INTERVAL_SECONDS=10

# ── Payments (wallet deposits) ──
# "none" turns deposits off. "chapa" needs CHAPA_SECRET_KEY and WEB_APP_URL.
PAYMENT_PROVIDER=none
# Chapa secret key (Chapa dashboard > Settings > API). The key decides the mode: CHASECK-... is live and takes
# real money, CHASECK_TEST-... is test mode where no money moves. Never commit a real key.
CHAPA_SECRET_KEY=
# Optional. The "secret hash" you type into the Chapa dashboard's webhook settings: any random value of 16+
# characters, for example from `openssl rand -hex 32`. Webhooks signed with anything else are refused. Left
# empty, every webhook is refused and deposits are confirmed when the user returns and by the background job.
CHAPA_WEBHOOK_SECRET=
CHAPA_BASE_URL=https://api.chapa.co
CHAPA_TIMEOUT_MS=15000
# Mobile wallets charged without leaving the site (Chapa direct charge): the payer approves on their phone.
# Chapa must have direct charge switched on for your account. Leave empty to use only Chapa's checkout page.
CHAPA_DIRECT_CHARGE_METHODS=telebirr,mpesa,cbebirr,ebirr
# Smallest and largest single deposit, in minor units (santim): 1000 = ETB 10, 5000000 = ETB 50,000.
DEPOSIT_MIN_MINOR=1000
DEPOSIT_MAX_MINOR=5000000
# A deposit that Chapa never confirms is closed as expired after this many minutes.
DEPOSIT_EXPIRY_MINUTES=120
# Top-up bonus: percent of each wallet top-up given as bonus (0 turns it off), the most one top-up earns (minor
# units: 1000000 = ETB 10,000), and how many days it lasts. Bonus is spent on bid fees before cash and cannot be
# withdrawn. Payments that pay for bids directly earn none.
TOPUP_BONUS_PERCENT=100
TOPUP_BONUS_MAX_MINOR=1000000
TOPUP_BONUS_VALID_DAYS=7
# How often (seconds) unconfirmed deposits are checked with Chapa. 0 disables the background job.
PAYMENT_SWEEP_INTERVAL_SECONDS=60
# This API's address as Chapa reaches it from the internet (no trailing slash), for example
# https://api.example.com. Leave empty on a laptop: deposits are then confirmed when the user returns
# from checkout and by the background job.
PUBLIC_API_URL=
# The website's address (no trailing slash). Users return to <WEB_APP_URL>/wallet/deposits/<id> after paying.
WEB_APP_URL=http://localhost:5173
