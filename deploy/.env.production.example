# Production settings for deploy/docker-compose.prod.yml. Copy to deploy/.env.production and fill in.
# Never commit deploy/.env.production: it holds the keys to every user's money.

# ── Addresses ──
# The API's own address (Caddy gets its HTTPS certificate for it). Its DNS A record must point at this server.
API_DOMAIN=api.leyubid.com
PUBLIC_API_URL=https://api.leyubid.com
# The user site; people come back here after paying on Chapa's page.
WEB_APP_URL=https://leyubid.com
# Every address the two websites are served from, comma-separated.
CORS_ORIGINS=https://leyubid.com,https://www.leyubid.com,https://admin.leyubid.com

# ── Database (only reachable inside this server) ──
POSTGRES_USER=leyubid
# A long random password: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=leyubid

# ── Secrets: three different values, each from: openssl rand -base64 48 ──
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OTP_HMAC_SECRET=

# ── Sign-up ──
PHONE_VERIFICATION_REQUIRED=false
OTP_PROVIDER=none

# ── Payments (Chapa) ──
# none = payments off. chapa = on, with the key below. CHASECK_TEST-… is test mode, CHASECK-… is real money.
PAYMENT_PROVIDER=chapa
CHAPA_SECRET_KEY=
# Optional: the webhook "secret hash" from Chapa's dashboard (16+ characters). Webhook URL:
# https://api.leyubid.com/api/v1/payments/chapa/webhook
CHAPA_WEBHOOK_SECRET=
CHAPA_DIRECT_CHARGE_METHODS=telebirr,mpesa,cbebirr,ebirr

# ── Top-up bonus ──
TOPUP_BONUS_PERCENT=100
TOPUP_BONUS_MAX_MINOR=1000000
TOPUP_BONUS_VALID_DAYS=7

# ── Other ──
SWAGGER_ENABLED=false
LOG_LEVEL=info

# ── Product pictures (Cloudflare R2) ───────────────────────────────────────────
# Leave empty to add pictures by address only. See "Product pictures" in deploy/README.md.
R2_ACCOUNT_ID=
UPLOADS_BUCKET=
UPLOADS_ACCESS_KEY_ID=
UPLOADS_SECRET_ACCESS_KEY=
# The bucket's public address, e.g. https://images.leyubid.com (no trailing slash)
UPLOADS_PUBLIC_URL=
UPLOADS_MAX_MB=5
